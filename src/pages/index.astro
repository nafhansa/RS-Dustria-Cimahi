---
import LandingLayout from '../layouts/LandingLayout.astro';
import Hero3D from '../components/landing/Hero3D.astro';
import DoctorPortrait from '../components/landing/DoctorPortrait';
import ServiceIcon from '../components/landing/ServiceIcon';
import { doctors, faqs, insurerPlaceholders, polis, scheduleSummary, services, stats, testimonials } from '../data/landing';
import { HOSPITAL, DAY_NAMES } from '../lib/constants';

const featuredDoctors = doctors.filter((d) => d.poliId !== 'POL-IGD');
const flow = [
  { title: 'Daftar', desc: 'Booking online atau di loket. Nomor antrian langsung terbit.', icon: 'M9 5h6M9 3h6a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zM10 12h4M10 16h4' },
  { title: 'Periksa', desc: 'Tanda vital oleh perawat, pemeriksaan dokter dengan rekam medis elektronik.', icon: 'M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6 6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3M8 15v1a6 6 0 0 0 6 6 6 6 0 0 0 6-6v-4M20 10a2 2 0 1 0 0-4 2 2 0 0 0 0 4z' },
  { title: 'Tindakan', desc: 'Laboratorium, radiologi, atau tindakan medis tercatat otomatis.', icon: 'M22 12h-4l-3 9L9 3l-3 9H2' },
  { title: 'Ambil Obat', desc: 'E-resep langsung ke farmasi, obat disiapkan dan diberi etiket.', icon: 'M10.5 20.5 3.5 13.5a4.95 4.95 0 1 1 7-7l7 7a4.95 4.95 0 1 1-7 7zM8.5 8.5l7 7' },
  { title: 'Bayar', desc: 'Tagihan transparan, bayar tunai, kartu, atau QRIS.', icon: 'M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4' },
];
const pillars = [
  { title: 'Tenaga medis bersertifikat', desc: 'Dokter spesialis dan perawat dengan STR/SIP aktif serta pelatihan berkala.', icon: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10zM9 12l2 2 4-4' },
  { title: 'Fasilitas modern', desc: 'Peralatan diagnostik digital, ruang periksa nyaman, dan sistem antrian terpadu.', icon: 'M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6M10 9h4M12 7v4' },
  { title: 'Data pasien aman', desc: 'Rekam medis elektronik dengan hak akses berlapis dan jejak audit lengkap.', icon: 'M7 11V7a5 5 0 0 1 10 0v4M5 11h14a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2z' },
  { title: 'Pelayanan ramah', desc: 'Kami mendengar, menjelaskan, dan mendampingi Anda di setiap langkah.', icon: 'M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7z' },
];
const days = [1, 2, 3, 4, 5, 6, 0];
---

<LandingLayout title={HOSPITAL.name} description="Rumah Sakit Dustira Cimahi: dokter spesialis, IGD 24 jam, poliklinik lengkap, dan pendaftaran online. Buat janji temu dan cek jadwal dokter dengan mudah." transparentNav>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(60%_60%_at_80%_20%,#fdecee_0%,rgba(255,255,255,0)_70%)]" aria-hidden="true"></div>
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 pt-8 pb-24 sm:px-6 lg:grid-cols-[1.05fr_1fr] lg:pt-14 lg:pb-32">
      <div>
        <p class="badge mb-5 bg-primary-soft px-3 py-1 text-primary-strong ring-1 ring-primary/15">
          <span class="h-1.5 w-1.5 rounded-full bg-primary"></span> Rumah Sakit Dustira · Cimahi
        </p>
        <h1 class="text-4xl leading-[1.1] font-bold text-text sm:text-5xl lg:text-[3.5rem]">
          Pelayanan yang Bisa Anda <span class="text-primary">Percaya</span>, Setiap Saat
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">Dokter spesialis berpengalaman, IGD siaga 24 jam, dan alur layanan terintegrasi dari pendaftaran hingga pembayaran. Semua untuk kesehatan keluarga Anda.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/janji-temu" class="btn btn-primary btn-lg">
            Buat Janji Temu
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
          </a>
          <a href="/dokter" class="btn btn-secondary btn-lg">Lihat Jadwal Dokter</a>
        </div>
        <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-3 text-sm font-medium text-text">
          {
            [
              ['Terakreditasi', 'M12 15a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM8.21 13.89 7 23l5-3 5 3-1.21-9.12'],
              ['Layanan 24 Jam', 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zM12 6v6l4 2'],
              ['Dokter Spesialis', 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75'],
            ].map(([label, d]) => (
              <li class="flex items-center gap-2">
                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-primary-soft text-primary">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d={d} />
                  </svg>
                </span>
                {label}
              </li>
            ))
          }
        </ul>
      </div>
      <Hero3D />
    </div>
  </section>

  <!-- Quick action bar -->
  <section class="relative z-10 -mt-16 px-4 sm:px-6" aria-label="Aksi cepat">
    <div class="mx-auto grid max-w-6xl gap-4 rounded-[20px] border border-border bg-white p-4 shadow-lift sm:p-6 lg:grid-cols-[1.6fr_1fr_0.9fr]">
      <form action="/dokter" method="get" class="grid gap-3 sm:grid-cols-[1fr_1fr_auto] sm:items-end">
        <p class="font-heading font-semibold sm:col-span-3">Cari Dokter</p>
        <label class="text-sm">
          <span class="field-label">Poliklinik</span>
          <select name="poli" class="input">
            <option value="">Semua poli</option>
            {polis.filter((p) => p.id !== 'POL-IGD').map((p) => <option value={p.slug}>{p.name}</option>)}
          </select>
        </label>
        <label class="text-sm">
          <span class="field-label">Hari</span>
          <select name="hari" class="input">
            <option value="">Semua hari</option>
            {days.map((d) => <option value={String(d)}>{DAY_NAMES[d]}</option>)}
          </select>
        </label>
        <button type="submit" class="btn btn-primary">Cari</button>
      </form>
      <form action="/janji-temu/sukses" method="get" class="grid gap-3 border-t border-border pt-4 sm:grid-cols-[1fr_auto] sm:items-end lg:border-t-0 lg:border-l lg:pt-0 lg:pl-6">
        <p class="font-heading font-semibold sm:col-span-2">Cek Antrian / Booking</p>
        <label class="text-sm">
          <span class="field-label">Kode booking</span>
          <input name="kode" class="input uppercase" placeholder="BK-261004-001" required pattern="[Bb][Kk]-\d{6}-\d{3}" title="Format: BK-YYMMDD-001" />
        </label>
        <button type="submit" class="btn btn-secondary">Cek</button>
      </form>
      <a href={`tel:${HOSPITAL.emergencyTel}`} class="group flex items-center gap-4 rounded-[14px] bg-primary p-4 text-white transition hover:bg-primary-hover">
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white/15">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.58 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        </span>
        <span>
          <span class="block text-xs font-semibold tracking-wider uppercase opacity-90">Gawat Darurat · 24 Jam</span>
          <span class="tabular block font-heading text-xl font-bold">{HOSPITAL.emergencyPhone}</span>
          <span class="block text-xs opacity-90">Tekan untuk menelepon IGD</span>
        </span>
      </a>
    </div>
  </section>

  <!-- Stats -->
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6" aria-label="Statistik">
    <dl class="grid grid-cols-2 gap-6 lg:grid-cols-4">
      {
        stats.map((s) => (
          <div class="flex flex-col rounded-[var(--radius-card)] border border-border bg-surface p-6 text-center">
            <dt class="order-2 mt-1 text-sm text-muted">{s.label}</dt>
            <dd class="tabular font-heading text-4xl font-extrabold text-text">
              <span data-count={s.value}>{s.value}</span>
              <span class="text-primary">{s.suffix}</span>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Services -->
  <section class="bg-surface py-20" id="layanan">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-sm font-semibold tracking-wider text-primary uppercase">Layanan Unggulan</p>
        <h2 class="mt-2 text-3xl font-bold sm:text-4xl">Poliklinik lengkap untuk seluruh keluarga</h2>
        <p class="mt-3 text-muted">Dari pemeriksaan rutin hingga penanganan spesialistik, didukung laboratorium dan radiologi di satu lokasi.</p>
      </div>
      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          services.map((s) => (
            <li>
              <a href={`/layanan#${s.slug}`} class="group flex h-full flex-col rounded-[var(--radius-card)] border border-border bg-white p-5 transition duration-200 hover:-translate-y-1 hover:border-primary/30 hover:shadow-lift">
                <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary-soft text-primary transition group-hover:bg-primary group-hover:text-white">
                  <ServiceIcon name={s.icon} />
                </span>
                <span class="mt-4 font-heading font-semibold text-text">{s.name}</span>
                <span class="mt-1 line-clamp-2 text-sm text-muted">{s.desc}</span>
                <span class="mt-auto pt-4 text-sm font-medium text-primary">Selengkapnya →</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Patient flow -->
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6" aria-labelledby="alur-title">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold tracking-wider text-primary uppercase">Alur Layanan Pasien</p>
      <h2 id="alur-title" class="mt-2 text-3xl font-bold sm:text-4xl">Terhubung dari daftar hingga bayar</h2>
      <p class="mt-3 text-muted">Sistem informasi rumah sakit kami menyambungkan setiap langkah, sehingga Anda tidak perlu mengulang data dan menunggu lebih lama.</p>
    </div>
    <ol class="flow relative mt-14 grid gap-8 md:grid-cols-5" data-flow>
      <span class="flow-line absolute top-7 right-[10%] left-[10%] hidden h-0.5 origin-left bg-primary md:block" aria-hidden="true"></span>
      {
        flow.map((f, i) => (
          <li class="flow-step relative text-center" style={`--d:${i * 120}ms`}>
            <span class="relative z-10 mx-auto flex h-14 w-14 items-center justify-center rounded-full border-4 border-white bg-primary text-white shadow-lift">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={f.icon} />
              </svg>
            </span>
            <p class="mt-3 text-xs font-semibold text-subtle">Langkah {i + 1}</p>
            <h3 class="font-heading text-lg font-semibold">{f.title}</h3>
            <p class="mx-auto mt-1 max-w-[220px] text-sm text-muted">{f.desc}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Doctors -->
  <section class="bg-surface py-20" aria-labelledby="dokter-title">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-sm font-semibold tracking-wider text-primary uppercase">Dokter Kami</p>
          <h2 id="dokter-title" class="mt-2 text-3xl font-bold sm:text-4xl">Ditangani oleh ahlinya</h2>
        </div>
        <div class="flex gap-2">
          <button type="button" class="btn-icon border border-border bg-white" data-carousel-prev aria-label="Dokter sebelumnya">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
          </button>
          <button type="button" class="btn-icon border border-border bg-white" data-carousel-next aria-label="Dokter berikutnya">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
          </button>
          <a href="/dokter" class="btn btn-secondary">Semua jadwal</a>
        </div>
      </div>
      <ul class="mt-10 -mx-4 flex snap-x snap-mandatory scroll-px-4 gap-4 overflow-x-auto scroll-smooth px-4 pb-4 [scrollbar-width:none]" data-carousel tabindex="0" aria-label="Daftar dokter">
        {
          featuredDoctors.map((d) => (
            <li class="w-[260px] shrink-0 snap-start">
              <article class="flex h-full flex-col overflow-hidden rounded-[var(--radius-card)] border border-border bg-white">
                <DoctorPortrait name={d.name} id={d.id} class="aspect-[4/3] w-full" />
                <div class="flex flex-1 flex-col p-4">
                  <h3 class="font-heading font-semibold text-text">{d.name}</h3>
                  <p class="text-sm text-muted">{d.specialty}</p>
                  <p class="mt-3 flex items-center gap-1.5 text-xs text-muted">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"></path></svg>
                    {scheduleSummary(d.id)}
                  </p>
                  <a href={`/janji-temu?dokter=${d.id}`} class="btn btn-soft btn-sm mt-4">Buat Janji</a>
                </div>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Why us -->
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6" aria-labelledby="kenapa-title">
    <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div>
        <p class="text-sm font-semibold tracking-wider text-primary uppercase">Kenapa Memilih Kami</p>
        <h2 id="kenapa-title" class="mt-2 text-3xl font-bold sm:text-4xl">Kepercayaan dibangun dari pelayanan yang konsisten</h2>
        <p class="mt-4 text-muted">Sejak lama, Rumah Sakit Dustira menjadi rujukan masyarakat Cimahi dan Bandung Barat. Kami terus berbenah agar setiap kunjungan terasa aman, jelas, dan manusiawi.</p>
        <a href="/tentang" class="btn btn-secondary mt-6">Tentang kami</a>
      </div>
      <ul class="grid gap-4 sm:grid-cols-2">
        {
          pillars.map((p) => (
            <li class="rounded-[var(--radius-card)] border border-border bg-white p-6">
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-primary-soft text-primary">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={p.icon} />
                </svg>
              </span>
              <h3 class="mt-4 font-heading font-semibold">{p.title}</h3>
              <p class="mt-1 text-sm text-muted">{p.desc}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="bg-surface py-20" aria-labelledby="testi-title">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-sm font-semibold tracking-wider text-primary uppercase">Testimoni</p>
        <h2 id="testi-title" class="mt-2 text-3xl font-bold sm:text-4xl">Cerita dari pasien kami</h2>
      </div>
      <ul class="mt-12 grid gap-6 md:grid-cols-3">
        {
          testimonials.map((t) => (
            <li class="flex flex-col rounded-[var(--radius-card)] border border-border bg-white p-6">
              <p class="flex gap-0.5 text-warning" role="img" aria-label={`Rating ${t.rating} dari 5`}>
                {Array.from({ length: t.rating }, () => (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z" />
                  </svg>
                ))}
              </p>
              <blockquote class="mt-4 flex-1 text-text">“{t.text}”</blockquote>
              <p class="mt-5 text-sm font-semibold">{t.name}</p>
              <p class="text-xs text-muted">{t.role}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-center text-xs text-subtle">Testimoni contoh untuk keperluan demo.</p>
    </div>
  </section>

  <!-- Insurers -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6" aria-labelledby="penjamin-title">
    <h2 id="penjamin-title" class="text-center text-sm font-semibold tracking-wider text-muted uppercase">Penjamin & mitra asuransi</h2>
    <ul class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
      {
        insurerPlaceholders.map((n) => (
          <li class="flex h-20 items-center justify-center gap-2 rounded-[var(--radius-card)] border border-dashed border-border px-3 text-center text-sm font-semibold text-subtle grayscale transition hover:text-muted">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            {n}
          </li>
        ))
      }
    </ul>
    <p class="mt-3 text-center text-xs text-subtle">Logo mitra ditampilkan setelah ada izin resmi.</p>
  </section>

  <!-- FAQ -->
  <section class="bg-surface py-20" aria-labelledby="faq-title">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <div class="text-center">
        <p class="text-sm font-semibold tracking-wider text-primary uppercase">FAQ</p>
        <h2 id="faq-title" class="mt-2 text-3xl font-bold sm:text-4xl">Pertanyaan yang sering diajukan</h2>
      </div>
      <div class="mt-10 space-y-3">
        {
          faqs.map((f, i) => (
            <details class="group rounded-[var(--radius-card)] border border-border bg-white p-5 open:shadow-soft" open={i === 0}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-heading font-semibold [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-primary-soft text-primary transition group-open:rotate-45" aria-hidden="true">
                  +
                </span>
              </summary>
              <p class="mt-3 text-muted">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="px-4 py-20 sm:px-6">
    <div class="relative mx-auto max-w-6xl overflow-hidden rounded-[24px] bg-primary-soft px-6 py-14 text-center sm:px-12">
      <div class="pointer-events-none absolute -top-24 -right-24 h-72 w-72 rounded-full bg-white/60 blur-2xl" aria-hidden="true"></div>
      <h2 class="relative text-3xl font-bold text-text sm:text-4xl">Butuh konsultasi? Buat janji sekarang.</h2>
      <p class="relative mx-auto mt-3 max-w-xl text-muted">Pilih poli, dokter, dan jam yang sesuai. Kode booking langsung Anda terima, tanpa antre panjang di loket.</p>
      <div class="relative mt-8 flex flex-wrap justify-center gap-3">
        <a href="/janji-temu" class="btn btn-primary btn-lg">Buat Janji Temu</a>
        <a href={`tel:${HOSPITAL.phoneTel}`} class="btn btn-secondary btn-lg">Hubungi {HOSPITAL.phone}</a>
      </div>
    </div>
  </section>
</LandingLayout>

<style>
  .flow-line {
    transform: scaleX(0);
    transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .flow-step {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.6s ease var(--d),
      transform 0.6s ease var(--d);
  }
  [data-flow].is-visible .flow-line {
    transform: scaleX(1);
  }
  [data-flow].is-visible .flow-step {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .flow-line {
      transform: none;
    }
    .flow-step {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  // count-up stats when visible
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const counters = document.querySelectorAll<HTMLElement>('[data-count]');
  const countIo = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        countIo.unobserve(e.target);
        const el = e.target as HTMLElement;
        const end = Number(el.dataset.count);
        if (reduce) continue;
        const start = performance.now();
        const step = (now: number) => {
          const p = Math.min((now - start) / 1400, 1);
          el.textContent = String(Math.round(end * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(step);
        };
        el.textContent = '0';
        requestAnimationFrame(step);
      }
    },
    { threshold: 0.6 },
  );
  counters.forEach((c) => countIo.observe(c));

  // flow line animation
  const flow = document.querySelector('[data-flow]');
  if (flow) {
    const io = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) {
          flow.classList.add('is-visible');
          io.disconnect();
        }
      },
      { threshold: 0.3 },
    );
    io.observe(flow);
  }

  // doctor carousel
  const track = document.querySelector<HTMLElement>('[data-carousel]');
  const by = () => (track ? Math.min(track.clientWidth * 0.8, 560) : 0);
  document.querySelector('[data-carousel-prev]')?.addEventListener('click', () => track?.scrollBy({ left: -by(), behavior: 'smooth' }));
  document.querySelector('[data-carousel-next]')?.addEventListener('click', () => track?.scrollBy({ left: by(), behavior: 'smooth' }));
</script>
