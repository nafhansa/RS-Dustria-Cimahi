---
import LandingLayout from '../layouts/LandingLayout.astro';
---

<LandingLayout title="Halaman tidak ditemukan" description="Halaman yang Anda cari tidak ditemukan.">
  <section class="mx-auto flex max-w-2xl flex-col items-center px-4 py-24 text-center">
    <p class="font-heading text-7xl font-extrabold text-primary">404</p>
    <h1 class="mt-4 text-3xl font-bold">Halaman tidak ditemukan</h1>
    <p class="mt-3 text-muted">Tautan mungkin sudah berubah atau halaman telah dipindahkan. Silakan kembali ke beranda atau gunakan menu di atas.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn btn-primary">Ke beranda</a>
      <a href="/janji-temu" class="btn btn-secondary">Buat janji temu</a>
      <a href="/kontak" class="btn btn-ghost">Hubungi kami</a>
    </div>
  </section>
</LandingLayout>
