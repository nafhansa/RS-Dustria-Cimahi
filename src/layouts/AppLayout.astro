---
import { ClientRouter, fade } from 'astro:transitions';
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import jakartaUrl from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Sidebar from '../components/app/Sidebar';
import Topbar from '../components/app/Topbar';
import Overlays from '../components/app/Overlays';
import { ROLE_LABEL } from '../lib/constants';
import type { Role } from '../lib/types';

interface Props {
  title: string;
  roles?: Role[];
  crumbs?: { label: string; href?: string }[];
  bare?: boolean;
}
const { title, roles = [], crumbs = [], bare = false } = Astro.props;
const allowedLabel = roles.map((r) => ROLE_LABEL[r]).join(', ');
---

<!doctype html>
<html lang="id" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jakartaUrl} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{`${title} · SIMRS RS Dustira`}</title>
    <script is:inline>
      try {
        if (!localStorage.getItem('rsd:session') && !location.pathname.startsWith('/app/login')) {
          location.replace('/app/login?next=' + encodeURIComponent(location.pathname + location.search));
        }
      } catch {
        /* storage unavailable */
      }
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body class="min-h-screen bg-surface text-text">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:rounded focus:bg-white focus:px-3 focus:py-2 focus:shadow-lift">Lewati ke konten utama</a>
    {
      bare ? (
        <main id="main" data-public>
          <slot />
        </main>
      ) : (
        <div class="flex min-h-screen">
          <Sidebar client:load transition:persist="sidebar" />
          <div class="flex min-w-0 flex-1 flex-col">
            <Topbar client:load crumbs={crumbs} transition:persist="topbar" />
            <main id="main" data-roles={roles.join(',')} class="flex-1 px-4 py-6 lg:px-8" transition:animate={fade({ duration: '0.12s' })}>
              <div data-denied-panel class="card mx-auto mt-10 hidden max-w-lg p-8 text-center">
                <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-warning-soft text-warning-strong" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                </div>
                <h1 class="text-lg font-semibold">Akses dibatasi untuk role ini</h1>
                <p class="mt-1 text-sm text-muted">Halaman ini tersedia untuk: {allowedLabel}, Super Admin.</p>
                <div class="mt-5 flex justify-center gap-2">
                  <a href="/app" class="btn btn-secondary">Ke Dashboard</a>
                  <button type="button" class="btn btn-primary" data-open-role-switch>Ganti Role</button>
                </div>
              </div>
              <div data-page>
                <slot />
              </div>
            </main>
            <footer class="no-print border-t border-border px-4 py-4 text-xs text-subtle lg:px-8">
              SIMRS Lite Demo · Rumah Sakit Dustira Cimahi · <strong class="font-semibold">Data fiktif untuk demo</strong>, bukan data pasien sebenarnya.
            </footer>
          </div>
        </div>
      )
    }
    <Overlays client:load transition:persist="overlays" />
    <script>
      import { $session } from '../stores/session';
      import { $roleSwitchOpen } from '../stores/ui';

      function applyGuard() {
        const main = document.getElementById('main');
        if (!main || main.hasAttribute('data-public')) return;
        const s = $session.get();
        if (!s) {
          location.replace('/app/login?next=' + encodeURIComponent(location.pathname + location.search));
          return;
        }
        const roles = (main.dataset.roles || '').split(',').filter(Boolean);
        const denied = roles.length > 0 && s.role !== 'SUPERADMIN' && !roles.includes(s.role);
        main.toggleAttribute('data-denied', denied);
      }
      document.addEventListener('astro:page-load', applyGuard);
      $session.listen(applyGuard);
      document.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('[data-open-role-switch]')) $roleSwitchOpen.set(true);
      });
    </script>
    <style is:global>
      main[data-denied] [data-page] {
        display: none;
      }
      main[data-denied] [data-denied-panel] {
        display: block;
      }
    </style>
  </body>
</html>
