---
import '../styles/global.css';
import Overlays from '../components/app/Overlays';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{`${title} · RS Dustira`}</title>
    <script is:inline>
      try {
        if (!localStorage.getItem('rsd:session')) location.replace('/app/login?next=' + encodeURIComponent(location.pathname + location.search));
      } catch {
        /* storage unavailable */
      }
    </script>
  </head>
  <body class="min-h-screen bg-surface-2 text-text print:bg-white">
    <main id="main">
      <slot />
    </main>
    <Overlays client:load />
    <style is:global>
      .print-doc {
        position: relative;
        background: #fff;
        margin: 0 auto;
        box-shadow: 0 10px 30px -10px rgb(16 24 40 / 0.2);
        overflow: hidden;
      }
      .print-doc .watermark {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        pointer-events: none;
        font-family: var(--font-heading);
        font-weight: 800;
        font-size: 120px;
        letter-spacing: 0.2em;
        color: rgb(208 27 40 / 0.06);
        transform: rotate(-24deg);
        z-index: 0;
      }
      .print-doc > *:not(.watermark):not(.stamp) {
        position: relative;
        z-index: 1;
      }
      @media print {
        @page {
          margin: 10mm;
        }
        .print-doc {
          box-shadow: none;
          margin: 0;
        }
        body {
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }
      }
    </style>
  </body>
</html>
