---
/**
 * 3D hero island. A static SVG poster (same framing as the scene) is the LCP-safe placeholder.
 * Three.js is dynamically imported only when visible, after idle, and only on capable devices.
 */
---

<div class="hero3d relative mx-auto aspect-square w-full max-w-[560px]" data-hero3d>
  <svg class="hero3d-poster absolute inset-0 h-full w-full" viewBox="0 0 560 560" role="img" aria-label="Ilustrasi salib medis kaca dengan inti merah">
    <defs>
      <radialGradient id="hp-bg" cx="50%" cy="48%" r="55%">
        <stop offset="0%" stop-color="#fdecee" />
        <stop offset="70%" stop-color="#fff5f6" stop-opacity="0.6" />
        <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="hp-glass" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#ffffff" />
        <stop offset="45%" stop-color="#fbe3e6" />
        <stop offset="100%" stop-color="#f3c9cf" />
      </linearGradient>
      <linearGradient id="hp-edge" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#ffffff" stop-opacity="0.95" />
        <stop offset="100%" stop-color="#e9aab3" stop-opacity="0.8" />
      </linearGradient>
      <linearGradient id="hp-core" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#ff4a52" />
        <stop offset="100%" stop-color="#b3121e" />
      </linearGradient>
      <filter id="hp-glow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="18" />
      </filter>
      <filter id="hp-shadow" x="-30%" y="-30%" width="160%" height="160%">
        <feDropShadow dx="0" dy="24" stdDeviation="22" flood-color="#9f121c" flood-opacity="0.18" />
      </filter>
    </defs>
    <circle cx="280" cy="270" r="250" fill="url(#hp-bg)" />
    <ellipse cx="280" cy="280" rx="236" ry="74" fill="none" stroke="#7a3a46" stroke-width="5" stroke-opacity="0.55" transform="rotate(-14 280 280)" />
    <g filter="url(#hp-shadow)">
      <path d="M232 112h96a22 22 0 0 1 22 22v76h76a22 22 0 0 1 22 22v96a22 22 0 0 1-22 22h-76v76a22 22 0 0 1-22 22h-96a22 22 0 0 1-22-22v-76h-76a22 22 0 0 1-22-22v-96a22 22 0 0 1 22-22h76v-76a22 22 0 0 1 22-22z" fill="url(#hp-glass)" stroke="url(#hp-edge)" stroke-width="6" />
    </g>
    <path d="M262 170h36v76h76v36h-76v76h-36v-76h-76v-36h76z" fill="#e62129" filter="url(#hp-glow)" opacity="0.55" />
    <path d="M258 166h44a6 6 0 0 1 6 6v68h68a6 6 0 0 1 6 6v44a6 6 0 0 1-6 6h-68v68a6 6 0 0 1-6 6h-44a6 6 0 0 1-6-6v-68h-68a6 6 0 0 1-6-6v-44a6 6 0 0 1 6-6h68v-68a6 6 0 0 1 6-6z" fill="url(#hp-core)" />
    <path d="M240 126h40" stroke="#fff" stroke-width="8" stroke-linecap="round" opacity="0.9" />
    <path d="M136 226v30" stroke="#fff" stroke-width="8" stroke-linecap="round" opacity="0.7" />
    <g fill="#e62129" opacity="0.35">
      <path d="M86 120h4v-4h4v4h4v4h-4v4h-4v-4h-4z" />
      <path d="M470 160h5v-5h5v5h5v5h-5v5h-5v-5h-5z" />
      <path d="M440 440h4v-4h4v4h4v4h-4v4h-4v-4h-4z" />
      <path d="M110 420h5v-5h5v5h5v5h-5v5h-5v-5h-5z" />
      <path d="M300 60h4v-4h4v4h4v4h-4v4h-4v-4h-4z" />
    </g>
  </svg>
  <canvas class="hero3d-canvas absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
  <p class="hero3d-hint pointer-events-none absolute bottom-2 left-1/2 -translate-x-1/2 rounded-full bg-white/80 px-3 py-1 text-xs text-muted shadow-soft backdrop-blur">Seret untuk memutar</p>
</div>

<style>
  .hero3d-canvas {
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .hero3d-hint {
    opacity: 0;
    transition: opacity 0.6s ease 0.6s;
  }
  .hero3d-poster {
    transition: opacity 0.8s ease;
  }
  [data-hero3d][data-ready='true'] .hero3d-canvas {
    opacity: 1;
  }
  [data-hero3d][data-ready='true'] .hero3d-hint {
    opacity: 1;
  }
  [data-hero3d][data-ready='true'] .hero3d-poster {
    opacity: 0;
  }
</style>

<script>
  const host = document.querySelector<HTMLElement>('[data-hero3d]');
  const canvas = host?.querySelector<HTMLCanvasElement>('canvas');

  /** WebGL available and hardware accelerated (software rasterizers such as SwiftShader are treated as unsupported). */
  function hasWebGL(): boolean {
    try {
      const c = document.createElement('canvas');
      const gl = (c.getContext('webgl2') || c.getContext('webgl')) as WebGLRenderingContext | null;
      if (!gl) return false;
      const info = gl.getExtension('WEBGL_debug_renderer_info');
      const renderer = info ? String(gl.getParameter(info.UNMASKED_RENDERER_WEBGL)) : '';
      gl.getExtension('WEBGL_lose_context')?.loseContext();
      return !/swiftshader|llvmpipe|software/i.test(renderer);
    } catch {
      return false;
    }
  }
  const nav = navigator as Navigator & { deviceMemory?: number };
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const lowEnd = (nav.hardwareConcurrency ?? 8) <= 4 && (nav.deviceMemory ?? 8) <= 4;

  let dispose: (() => void) | undefined;

  async function load() {
    // wait for the main thread to be idle so LCP/TBT are not affected
    await new Promise<void>((r) => setTimeout(r, 1200));
    await new Promise<void>((r) => ('requestIdleCallback' in window ? requestIdleCallback(() => r(), { timeout: 2500 }) : setTimeout(r, 300)));
    if (!force && !hasWebGL()) return;
    const { mount } = await import('./scene');
    if (host && canvas) dispose = mount(canvas, host);
  }

  // Phones/tablets: only after the first interaction, so the static poster stays the LCP and the main thread stays free.
  const force = new URLSearchParams(location.search).has('3d'); // ?3d forces the scene (demo on any machine)
  const coarse = !force && (matchMedia('(pointer: coarse)').matches || window.innerWidth < 768);
  const waitForInteraction = () =>
    new Promise<void>((resolve) => {
      const events = ['pointerdown', 'touchstart', 'scroll', 'keydown'];
      const go = () => {
        events.forEach((e) => window.removeEventListener(e, go));
        resolve();
      };
      events.forEach((e) => window.addEventListener(e, go, { once: true, passive: true }));
    });

  if (host && canvas && (force || (!reduce && !lowEnd))) (coarse ? waitForInteraction() : Promise.resolve()).then(() => {
    const io = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) {
          io.disconnect();
          load().catch(() => {
            /* keep static poster */
          });
        }
      },
      { rootMargin: '100px' },
    );
    io.observe(host);
  });

  document.addEventListener('astro:before-swap', () => dispose?.());
</script>
