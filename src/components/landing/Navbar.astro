---
import { Image } from 'astro:assets';
import logo from '../../assets/images/logo.png';
import { HOSPITAL } from '../../lib/constants';

interface Props {
  active?: string;
  transparent?: boolean;
}
const { active = '', transparent = false } = Astro.props;
const links = [
  { href: '/layanan', label: 'Layanan' },
  { href: '/dokter', label: 'Dokter' },
  { href: '/tentang', label: 'Tentang' },
  { href: '/kontak', label: 'Kontak' },
];
---

<div class="bg-ink text-white">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-1.5 text-xs sm:px-6">
    <a href={`tel:${HOSPITAL.emergencyTel}`} class="inline-flex items-center gap-2 font-medium hover:underline">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.58 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
      <span><span class="rounded bg-primary px-1.5 py-0.5 font-bold">IGD 24 Jam</span> {HOSPITAL.emergencyPhone}</span>
    </a>
    <span class="hidden text-white/70 sm:inline">Senin - Sabtu 07.00 - 20.00 · Cimahi, Jawa Barat</span>
  </div>
</div>
<header id="site-nav" data-transparent={transparent ? 'true' : 'false'} class="sticky top-0 z-50 border-b border-transparent transition-[background,border-color,box-shadow] duration-300">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:h-[72px]" aria-label="Navigasi utama">
    <a href="/" class="flex shrink-0 items-center" aria-label="Beranda Rumah Sakit Dustira">
      <Image src={logo} alt="Rumah Sakit Dustira" width={180} height={45} class="h-9 w-auto lg:h-10" loading="eager" fetchpriority="high" />
    </a>
    <ul class="hidden items-center gap-1 md:flex">
      {
        links.map((l) => (
          <li>
            <a href={l.href} aria-current={active === l.href ? 'page' : undefined} class:list={['rounded-lg px-3 py-2 text-sm font-medium transition hover:bg-surface-2 hover:text-text', active === l.href ? 'text-primary' : 'text-muted']}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="hidden items-center gap-2 md:flex">
      <a href="/app/login" data-astro-prefetch="hover" class="btn btn-secondary">Masuk Staf</a>
      <a href="/janji-temu" class="btn btn-primary">Buat Janji Temu</a>
    </div>
    <button id="nav-toggle" type="button" class="btn-icon md:hidden" aria-label="Buka menu" aria-expanded="false" aria-controls="nav-drawer">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
    </button>
  </nav>
  <div id="nav-drawer" class="hidden border-t border-border bg-white px-4 pt-2 pb-5 shadow-lift md:hidden">
    <ul class="space-y-1">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="block rounded-lg px-3 py-2.5 font-medium text-text hover:bg-surface-2">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-4 grid gap-2">
      <a href="/janji-temu" class="btn btn-primary">Buat Janji Temu</a>
      <a href="/app/login" class="btn btn-secondary">Masuk Staf</a>
    </div>
  </div>
</header>

<script>
  const nav = document.getElementById('site-nav')!;
  const toggle = document.getElementById('nav-toggle')!;
  const drawer = document.getElementById('nav-drawer')!;
  const solid = () => {
    const isSolid = nav.dataset.transparent !== 'true' || window.scrollY > 24 || !drawer.classList.contains('hidden');
    nav.classList.toggle('bg-white/95', isSolid);
    nav.classList.toggle('backdrop-blur', isSolid);
    nav.classList.toggle('border-border', isSolid);
    nav.classList.toggle('shadow-soft', isSolid && window.scrollY > 24);
  };
  solid();
  window.addEventListener('scroll', solid, { passive: true });
  toggle.addEventListener('click', () => {
    const open = drawer.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Tutup menu' : 'Buka menu');
    solid();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !drawer.classList.contains('hidden')) {
      drawer.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.focus();
      solid();
    }
  });
</script>
